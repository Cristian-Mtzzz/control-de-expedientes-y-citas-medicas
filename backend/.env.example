# Copia este archivo como .env y ajusta los valores
PORT=4000

# --- Conexión a Oracle Database ---------------------------------------------
ORACLE_USER=consultorio
ORACLE_PASSWORD=consultorio
# host:puerto/nombre_del_servicio
#   Oracle 11g XE  -> localhost:1521/XE
#   Oracle 21c XE  -> localhost:1521/XEPDB1
#   Oracle 23ai Free -> localhost:1521/FREEPDB1
ORACLE_CONNECT=localhost:1521/XE

# Carpeta con las librerías cliente de Oracle (modo "thick" de node-oracledb).
# Es obligatoria con Oracle 11g, porque el modo "thin" (sin librerías) solo
# admite Oracle 12.1 o más reciente. Apunta al bin de la instalación de Oracle:
#   Windows, 11g XE -> C:\oraclexe\app\oracle\product\11.2.0\server\bin
# Si tu base es 12.1 o mayor, puedes dejar esta línea vacía.
ORACLE_CLIENT_LIB=C:\oraclexe\app\oracle\product\11.2.0\server\bin

# --- Aplicación --------------------------------------------------------------
# Cambia esto por una cadena larga y aleatoria antes de usarlo en serio
JWT_SECRET=cambia-esto-por-una-clave-larga-y-secreta
TZ=America/Tegucigalpa
